# Server
PORT=8787
HOST=0.0.0.0
APP_BASE_URL=http://localhost:8787
DATA_FILE=.data/nayl.json
DEFAULT_MARKET=AE
DEFAULT_CITY=Dubai
DEMO_BUSINESS_ID=biz-baytcare

# Optional live search connectors
BRAVE_SEARCH_API_KEY=
GOOGLE_MAPS_API_KEY=

# Explicit demo connector. Keep true to demonstrate the future partner adapter.
ENABLE_PARTNER_DEMO=true

# Connector timeout and basic API rate limiting
CONNECTOR_TIMEOUT_MS=7000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
